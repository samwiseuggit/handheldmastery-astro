---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { render } from "astro:content";
import AmazonDisclosure from "../../components/AmazonDisclosure.astro";
import CommerceArtwork from "../../components/CommerceArtwork.astro";
import { amazonProductUrl } from "../../lib/amazon-affiliate";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const mentionedProducts = (await Promise.all(
  (article.data.products ?? []).map((slug) => getEntry("products", slug)),
)).filter((product) => product !== undefined);

// Get 3 random related articles
const allArticles = await getCollection("articles");
const related = allArticles
  .filter((a) => a.slug !== article.slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

const articleUrl = new URL(`/articles/${article.slug}`, "https://handheldmastery.com").toString();
const articleSchema = {
  "@context": "https://schema.org",
  "@type": article.data.type === "review" ? "Review" : "BlogPosting",
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.date,
  dateModified: article.data.date,
  mainEntityOfPage: articleUrl,
  author: {
    "@type": "Organization",
    name: "Hand Held Mastery",
  },
  publisher: {
    "@type": "Organization",
    name: "Hand Held Mastery",
    logo: {
      "@type": "ImageObject",
      url: "https://handheldmastery.com/logo.png",
    },
  },
};
const faqSchema = article.data.faq && article.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.data.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
} : null;
const structuredData = [articleSchema, faqSchema].filter(Boolean);
---

<Layout
  title={`${article.data.seoTitle || article.data.title} | Hand Held Mastery`}
  description={article.data.description}
  active="blog"
  ogType="article"
  structuredData={structuredData}
>
  <div class="max-w-[1100px] mx-auto px-4 pt-5 pb-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-text-dim mb-6">
      <a href="/" class="text-text-muted hover:text-accent-cyan">Home</a>
      <span class="mx-2 text-text-faint">&rsaquo;</span>
      <a href="/blog" class="text-text-muted hover:text-accent-cyan">Blog</a>
      <span class="mx-2 text-text-faint">&rsaquo;</span>
      <span>{article.data.title}</span>
    </nav>

    <!-- Article Header -->
    <div class="mb-8">
      <span class="inline-block px-3 py-1 bg-[#0F172A] text-accent-cyan-light text-xs font-semibold uppercase tracking-wider mb-3">
        {article.data.category}
      </span>
      <div class="flex items-center gap-4 text-sm text-text-dim mb-4">
        <span>{article.data.date}</span>
        <span>&middot;</span>
        <span>{article.data.readTime}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary mb-4">{article.data.title}</h1>
      <div class="flex flex-wrap gap-2">
        {article.data.tags.map((tag) => (
          <span class="text-xs px-2 py-1 bg-[#0F172A] text-text-muted">{tag}</span>
        ))}
      </div>
    </div>

    {mentionedProducts.length === 0 && (
      <div class="mb-8 overflow-hidden rounded-xl">
        <CommerceArtwork name={article.data.title} category={article.data.category} compact />
      </div>
    )}

    {mentionedProducts.length > 0 && (
      <section class="mb-10 grid overflow-hidden border border-accent-cyan/40 bg-card-dark lg:grid-cols-[1.05fr_0.95fr]">
        <div class="order-2 lg:order-1">
          <CommerceArtwork name={mentionedProducts[0].data.name} category={mentionedProducts[0].data.category} showCaption={false} />
        </div>
        <aside class="order-1 p-5 sm:p-6 lg:order-2" aria-labelledby="shop-mentioned-products">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold tracking-[0.18em] uppercase text-accent-cyan-light">Products in this guide</p>
              <h2 id="shop-mentioned-products" class="mt-1 text-xl font-bold text-text-primary">Check current availability and configurations</h2>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">Amazon prices and stock can change. Confirm the exact model, capacity, and compatibility on the listing before ordering.</p>
            </div>
            <AmazonDisclosure />
          </div>
          <div class="mt-5 grid gap-3">
            {mentionedProducts.slice(0, 4).map((product) => (
              <a href={amazonProductUrl(product.data.slug, product.data.name)} target="_blank" rel="sponsored noopener noreferrer" class="group flex items-center justify-between gap-4 border border-border-dark bg-[#0B0F1A] px-4 py-3 hover:border-accent-cyan transition-colors">
                <span class="text-sm font-semibold text-text-primary group-hover:text-accent-cyan">{product.data.name}</span>
                <span class="shrink-0 text-xs font-bold uppercase tracking-wider text-[#ffb86b]">View on Amazon &rarr;</span>
              </a>
            ))}
          </div>
        </aside>
      </section>
    )}

    <!-- Article Body -->
    <article class="prose-custom mb-12">
      <Content />
    </article>

    {article.data.faq && article.data.faq.length > 0 && (
      <section class="mb-12 border-t border-border-dark pt-8" aria-labelledby="article-faq-title">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-accent-cyan-light">Buyer questions</p>
        <h2 id="article-faq-title" class="mt-1 text-2xl font-bold text-text-primary">Frequently asked questions</h2>
        <div class="mt-6 grid gap-4">
          {article.data.faq.map((item) => (
            <details class="group border border-border-dark bg-card-dark p-5">
              <summary class="cursor-pointer list-none pr-8 font-semibold text-text-primary marker:hidden">{item.question}</summary>
              <p class="mt-3 leading-relaxed text-text-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <div class="bg-gradient-to-br from-[rgba(109,40,217,0.15)] to-[rgba(8,145,178,0.15)] border border-border-dark p-8 text-center mb-12">
      <h3 class="text-lg font-bold text-text-primary mb-2">Compare products mentioned in this article</h3>
      <p class="text-text-muted mb-5">Browse handheld gaming product guides and specs.</p>
      <a href="/compare" class="inline-flex items-center gap-2 bg-accent-purple text-white font-semibold px-6 py-3 hover:bg-accent-purple-hover transition-colors">
        Go to Comparison &rarr;
      </a>
    </div>

    <!-- Related Articles -->
    <div class="mb-12">
      <h3 class="text-lg font-bold text-text-primary mb-4">Related Articles</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map((a) => (
          <a href={`/articles/${a.slug}`} class="block bg-card-dark border border-border-dark p-5 hover:border-accent-purple transition-all hover:-translate-y-0.5">
            <div class="text-sm font-semibold text-text-primary mb-2 line-clamp-2">{a.data.title}</div>
            <div class="text-xs text-text-dim">Read more &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .prose-custom :global(h2) { font-size: 1.5rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 0.875rem; padding-bottom: 0.5rem; border-bottom: 1px solid #1E293B; color: #F8FAFC; }
    .prose-custom :global(h3) { font-size: 1.25rem; font-weight: 600; margin-top: 1.75rem; margin-bottom: 0.625rem; color: #F1F5F9; }
    .prose-custom :global(h4) { font-size: 1.1rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.5rem; color: #CBD5E1; }
    .prose-custom :global(p) { margin-bottom: 1rem; color: #CBD5E1; line-height: 1.75; }
    .prose-custom :global(ul), .prose-custom :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
    .prose-custom :global(li) { margin-bottom: 0.375rem; color: #CBD5E1; }
    .prose-custom :global(strong) { color: #F8FAFC; }
    .prose-custom :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.875rem; }
    .prose-custom :global(th) { background: #0F172A; padding: 0.625rem 0.75rem; text-align: left; font-weight: 600; color: #94A3B8; border-bottom: 2px solid #334155; }
    .prose-custom :global(td) { padding: 0.5rem 0.75rem; border-bottom: 1px solid #1E293B; color: #CBD5E1; }
    .prose-custom :global(blockquote) { border-left: 3px solid #38BDF8; padding-left: 1rem; margin: 1.25rem 0; color: #94A3B8; font-style: italic; }
    .prose-custom :global(a) { color: #38BDF8; }
    .prose-custom :global(a:hover) { text-decoration: underline; }
    .prose-custom :global(hr) { border: none; border-top: 1px solid #1E293B; margin: 2rem 0; }
  </style>
</Layout>
